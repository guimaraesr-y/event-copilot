# Event Command Center — deterministic smoke environment
# Safe for local automated tests. Does NOT use Meta/real WhatsApp credentials.

# Docker Compose isolation
COMPOSE_PROJECT_NAME=event-command-center-smoke
GATEWAY_PORT=18080
BASE_URL=http://localhost:18080

# PostgreSQL shared server, separate logical databases (ecc + n8n)
POSTGRES_USER=ecc_smoke
POSTGRES_PASSWORD=ecc-smoke-local-password
POSTGRES_DB=ecc
DATABASE_URL=postgres://ecc_smoke:ecc-smoke-local-password@postgres:5432/ecc

# API
API_PORT=3000
LOG_LEVEL=info

# Worker / transactional outbox / n8n domain-event transport
OUTBOX_TRANSPORT=n8n
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=50
OUTBOX_WAIT_SECONDS=45
N8N_DOMAIN_EVENTS_URL=http://n8n:5678/webhook/ecc-domain-events
DOMAIN_EVENT_SHARED_SECRET=smoke-domain-events-secret-2026-0123456789abcdef

# n8n
N8N_ENCRYPTION_KEY=smoke-n8n-encryption-key-2026-0123456789abcdef
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:18080/
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_READY_WAIT_SECONDS=60

# Messaging — smoke MUST stay on the deterministic mock provider
WHATSAPP_PROVIDER=mock
MESSAGING_WEBHOOK_SHARED_SECRET=smoke-messaging-webhook-secret-2026-0123456789abcdef

# Meta WhatsApp Cloud — deliberately disabled in smoke
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
