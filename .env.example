# PostgreSQL shared server, separate logical databases
POSTGRES_USER=ecc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecc
DATABASE_URL=postgres://ecc:change-me@postgres:5432/ecc

# API
API_PORT=3000
LOG_LEVEL=info

# Worker
OUTBOX_TRANSPORT=console
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
N8N_DOMAIN_EVENTS_URL=http://n8n:5678/webhook/domain-events

# n8n
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:8080/
GENERIC_TIMEZONE=America/Sao_Paulo
