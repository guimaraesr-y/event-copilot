# Docker Compose / local gateway
COMPOSE_PROJECT_NAME=event-command-center
GATEWAY_PORT=8080
BASE_URL=http://localhost:8080

# PostgreSQL shared server, separate logical databases
POSTGRES_USER=ecc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecc
DATABASE_URL=postgres://ecc:change-me@postgres:5432/ecc

# API
API_PORT=3000
LOG_LEVEL=info

# Worker
OUTBOX_TRANSPORT=n8n
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
N8N_DOMAIN_EVENTS_URL=http://n8n:5678/webhook/ecc-domain-events
DOMAIN_EVENT_SHARED_SECRET=replace-with-at-least-32-random-characters

# n8n
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:8080/
GENERIC_TIMEZONE=America/Sao_Paulo

# Messaging
# mock | meta
WHATSAPP_PROVIDER=mock
MESSAGING_WEBHOOK_SHARED_SECRET=replace-with-at-least-32-random-characters

# Meta WhatsApp Cloud
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Command Engine
# rule_based | ai
COMMAND_INTERPRETER=rule_based

# AI command provider (used only when COMMAND_INTERPRETER=ai)
# ollama | openai
AI_PROVIDER=ollama

# Ollama (self-hosted, Compose profile: ai)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
OLLAMA_COMMAND_MODEL=qwen3:4b
OLLAMA_COMMAND_TIMEOUT_MS=120000
OLLAMA_KEEP_ALIVE=10m

# OpenAI (optional alternative provider)
OPENAI_API_KEY=
OPENAI_COMMAND_MODEL=gpt-5.6
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_COMMAND_TIMEOUT_MS=20000

# Operational Agent
OPERATIONAL_AGENT_PROVIDER=ollama
# Defaults to OLLAMA_COMMAND_MODEL when blank in the application factory.
OLLAMA_AGENT_MODEL=
# prompt works with small models without native tools (for example Phi-3); native requires model tool support.
OLLAMA_AGENT_TOOL_MODE=prompt
OLLAMA_AGENT_TIMEOUT_MS=120000
OPERATIONAL_AGENT_MAX_MODEL_CALLS=6
OPERATIONAL_AGENT_MAX_TOOL_CALLS=8
OPERATIONAL_AGENT_HISTORY_TURNS=6
