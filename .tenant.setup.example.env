# API to configure. Local development default:
BASE_URL=http://localhost:8080

# Tenant
TENANT_NAME=Meu Cerimonial
TENANT_TIMEZONE=America/Sao_Paulo
# Optional for an already-created tenant. If omitted, the first run creates one
# and stores its id in TENANT_STATE_FILE.
TENANT_ORGANIZATION_ID=
TENANT_STATE_FILE=.ecc/tenants/meu-cerimonial.json

# Initial event/template
EVENT_NAME=Casamento Teste
EVENT_TYPE=wedding
EVENT_START_AT=2026-10-17T17:30:00-03:00
EVENT_END_AT=
EVENT_GUEST_COUNT=120
EVENT_VENUE_NAME=
EVENT_VENUE_ADDRESS=
TEMPLATE_NAME=Casamento Padrão
SETUP_DEFAULT_TEMPLATE_PLAN=true

# Vendor used for the first real confirmation test
VENDOR_NAME=Fornecedor Teste Ryan
VENDOR_CATEGORY=photo
VENDOR_CONTACT_NAME=Ryan
VENDOR_PHONE=+5521999999999
VENDOR_EMAIL=
VENDOR_NOTES=Fornecedor usado para validar o fluxo de confirmação.
VENDOR_CONTRACT_STATUS=signed
VENDOR_PAYMENT_STATUS=not_applicable

# Optional deadline sent with confirmation-request
CONFIRMATION_DEADLINE_AT=
